{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "lagrange": {
        "type": "local",
        "command": ["node", "mcp-server/index.js"],
        "environment": {
          "LAGRANGE_HOST": "opencode"
        },
        "timeout": {
          "startup": 10000,
          "catalog": 10000,
          "execution": 1800000
        }
      }
    }
  }
}
