# Imagen del agente para los lotes en contenedor (FEAT-061 fase 2).
#
# Es la imagen de la sonda S5 (verificada el 2026-09-18) más `jq`, que usa el
# refrescador para recortar el token.
#
# Decisiones que vienen de medir, no de preferencia:
#  - uid 1001: en Ubuntu 24.04 el 1000 ya es `ubuntu`;
#  - agy en /usr/local/bin: el home va en un `tmpfs` en tiempo de ejecución, y
#    eso tapaba `~/.local/bin`, donde lo deja el instalador;
#  - sin keyring ni D-Bus: el token de agy es un archivo, no una entrada de
#    keyring (medido en S5/S8), así que no hace falta nada de eso.
#
# Actualizar agy = cambiar AGY_VERSION y reconstruir: el auto-actualizador queda
# cortado por la allowlist del proxy, a propósito. El instalador siempre baja la
# última (no acepta versión): AGY_VERSION no la elige, la COMPRUEBA, así una
# versión nueva nunca entra sin que alguien la haya pedido y probado.
FROM ubuntu:24.04

# FEAT-153 — 1.3.3 (2026-10-10): la última publicada para Linux; antes era 1.2.6 sin fijar.
ARG AGY_VERSION=1.3.3

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git jq \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1001 -s /bin/bash agy

USER agy
RUN curl -fsSL https://antigravity.google/cli/install.sh | bash

USER root
RUN mv /home/agy/.local/bin/agy /usr/local/bin/agy && chmod 755 /usr/local/bin/agy \
    && agy --version | grep -F "${AGY_VERSION}"

USER agy
WORKDIR /home/agy

# FEAT-154 — La versión que trae la imagen, comprobada arriba: la consola la lee con `docker image inspect`
# sin arrancar un contenedor. Al final, para no invalidar la caché de las capas anteriores.
LABEL io.lagrange.harness.version="${AGY_VERSION}"
