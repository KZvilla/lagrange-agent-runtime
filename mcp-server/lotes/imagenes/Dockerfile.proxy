# Proxy de egress para los lotes (FEAT-061 fase 2).
#
# Tinyproxy con allowlist y deny por defecto. Es el UNICO camino a internet del
# contenedor del agente: su red es `--internal` y el proxy es el unico que
# ademas esta en `bridge`.
#
# La lista de hosts se monta en tiempo de ejecucion (`/etc/tinyproxy/permitidos`,
# de solo lectura): hay dos, la del agente y la del refrescador, y montarlas en
# vez de hornearlas evita dos imagenes casi iguales.
FROM alpine:3.20

RUN apk add --no-cache tinyproxy

COPY tinyproxy.conf /etc/tinyproxy/tinyproxy.conf

EXPOSE 8888
CMD ["tinyproxy", "-d", "-c", "/etc/tinyproxy/tinyproxy.conf"]
